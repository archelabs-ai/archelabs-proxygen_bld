"""
Alias targets for liburing (io_uring support library).
These forward to the actual implementation in @liburing_repo.
"""

package(default_visibility = ["//visibility:public"])

# Export the pre-generated config headers
exports_files([
    "config-host.h",
    "compat.h",
    "io_uring_version.h",
])

alias(
    name = "liburing",
    actual = "@liburing_repo//:liburing",
)

alias(
    name = "uring",
    actual = "@liburing_repo//:uring",
)
