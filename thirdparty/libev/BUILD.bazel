"""
Alias targets for libev (high-performance event loop library).
These forward to the actual implementation in @libev_repo.
"""

package(default_visibility = ["//visibility:public"])

# Export the pre-generated config.h for the libev_repo BUILD file
exports_files(["config.h"])

alias(
    name = "libev",
    actual = "@libev_repo//:libev",
)
